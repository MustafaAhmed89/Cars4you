{
  "name": "cars4you",
  "version": "0.0.1",
  "private": true,
  "description": "CarsRide / Cars4you — used-car marketplace (mobile-first, web later). Turborepo monorepo.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MustafaAhmed89/Cars4you.git"
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.types.ts",
    "db:types:remote": "supabase gen types typescript --linked > packages/types/src/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "supabase": "^2.109.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
